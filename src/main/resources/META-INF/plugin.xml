<idea-plugin>
    <id>ru.mythographica.mnemographica</id>
    <name>Mnemonica Graphica</name>
    <vendor url="https://github.com/mythographica">mythographica</vendor>
    <description><![CDATA[
    Mnemonica Graphica for OpenIDE: the unmodified <a href="https://github.com/mythographica/mnemographica">mnemographica</a>
    VS Code extension running in a Node.js sidecar. Browse a project's Mnemonica type graph (Types, Usages, Flow,
    By Generation, Diamonds, Bagels, Live Trace), open the interactive 3D graph, and use Ctrl+Click and
    Find Mnemonica References on Mnemonica types. Requires Node.js 18 or newer and a project with a
    <code>.tactica/</code> directory produced by <code>@mnemonica/tactica</code>.
    ]]></description>
    <change-notes><![CDATA[
    <h3>0.1.0</h3>
    <ul>
        <li>First release: the mnemographica 0.5.9 extension runs in a Node.js sidecar inside OpenIDE.</li>
        <li>Mnemonica tool window with the Live Trace, Usages, Types, Flow, By Generation, Diamonds and Bagels tabs.</li>
        <li>Webview editors on JCEF: Ψ 3D, Ψ Strategy MCP and Ψ App Channel, with IDE theme colors and vendored d3 and three.</li>
        <li>Ctrl+Click go to definition and the Find Mnemonica References action (Alt+Shift+F4).</li>
        <li>Settings | Tools | Mnemonica for the Node.js path and the extension's options.</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF is the bundled "Web Browser (JCEF)" plugin in 262; webview panels need it. -->
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Mnemonica" anchor="left" icon="/icons/mnemonica.svg"
                    factoryClass="ru.mythographica.mnemographica.toolwindow.MnemonicaToolWindowFactory"/>
        <postStartupActivity implementation="ru.mythographica.mnemographica.sidecar.MnemonicaStartupActivity"/>
        <statusBarWidgetFactory id="MnemonicaStatus"
                                implementation="ru.mythographica.mnemographica.ui.MnemonicaStatusBarWidgetFactory"/>
        <notificationGroup id="Mnemonica" displayType="BALLOON"/>
        <projectConfigurable parentId="tools" id="ru.mythographica.mnemographica.settings" displayName="Mnemonica"
                             instance="ru.mythographica.mnemographica.settings.MnemonicaConfigurable"/>
        <gotoDeclarationHandler implementation="ru.mythographica.mnemographica.navigation.MnemonicaGotoDeclarationHandler"/>
        <fileEditorProvider implementation="ru.mythographica.mnemographica.webview.WebviewFileEditorProvider"/>
    </extensions>

    <applicationListeners>
        <!-- mnemo-res:// must be registered before JCEF starts. -->
        <listener class="ru.mythographica.mnemographica.webview.ResourceSchemeRegistrar"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <actions>
        <!-- Sidecar commands (Mnemonica.<command>) are registered at runtime from InitializeResult.commands. -->
        <group id="Mnemonica.ToolsGroup" text="Mnemonica" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Mnemonica.RestartSidecar" class="ru.mythographica.mnemographica.actions.RestartSidecarAction"
                    text="Restart Mnemonica Sidecar" description="Stop and start the Mnemonica Node sidecar"/>
            <separator/>
        </group>
        <action id="Mnemonica.FindReferences" class="ru.mythographica.mnemographica.navigation.FindReferencesAction"
                text="Find Mnemonica References" description="Find usages of the Mnemonica type at the caret">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift F4"/>
        </action>
    </actions>
</idea-plugin>
